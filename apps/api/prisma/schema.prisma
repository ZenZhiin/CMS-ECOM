generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id        String         @id @default(uuid())
  email     String         @unique
  password  String
  name      String?        @map("name")
  role      Role           @default(VIEWER)
  entries   ContentEntry[]
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("users")
}

model ContentType {
  id        String         @id @default(uuid())
  name      String
  slug      String         @unique
  fields    Json           @map("fields") // JSON definition of fields
  entries   ContentEntry[]
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("content_types")
}

model ContentEntry {
  id            String      @id @default(uuid())
  contentType   ContentType @relation(fields: [contentTypeId], references: [id])
  contentTypeId String      @map("content_type_id")
  author        User        @relation(fields: [authorId], references: [id])
  authorId      String      @map("author_id")
  data          Json        @map("data")
  status        Status      @default(DRAFT)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("content_entries")
}

model Media {
  id        String   @id @default(uuid())
  filename  String   @map("filename")
  path      String   @map("path")
  mimetype  String   @map("mimetype")
  size      Int      @map("size")
  url       String   @map("url")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("media")
}

model GlobalSettings {
  id           String   @id @default("global")
  siteName     String   @default("Zhiin CMS") @map("site_name")
  siteLogo     String?  @map("site_logo")
  navigation   Json     @default("[]") @map("navigation")
  footerNavigation Json @default("[]") @map("footer_navigation")
  socialLinks  Json     @default("[]") @map("social_links")
  footerText   String?  @map("footer_text")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("global_settings")
}

model ApiKey {
  id        String   @id @default(uuid())
  name      String   @map("name")
  key       String   @unique @map("key")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("api_keys")
}
